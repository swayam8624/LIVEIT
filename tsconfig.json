{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.ts",
    "content/**/*.ts",
    "tests/**/*.ts",
    "apps/player/**/*.ts",
    "apps/player/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "**/.expo"]
}
